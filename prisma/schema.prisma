generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  /// The unique ID of the user.
  id                Int           @id @default(autoincrement())

  /// The display name of the user.
  name              String

  /// The profile picture URL of the user.
  profilePicture    String

  /// The Slack user ID for this user.
  slackId           String        @unique

  /// The Hack Club Auth identity ID.
  hcaId             String?       @unique

  /// The identity vault ID of the user.
  idvId             String?

  /// Email address from HCA.
  email             String?

  /// First name from HCA profile.
  firstName         String?

  /// Last name from HCA profile.
  lastName          String?

  /// Legal first name from HCA.
  legalFirstName    String?

  /// Legal last name from HCA.
  legalLastName     String?

  /// Birthday from HCA.
  birthday          DateTime?

  /// Address line 1 from HCA.
  addressLine1      String?

  /// Address line 2 from HCA.
  addressLine2      String?

  /// City from HCA.
  city              String?

  /// State or province from HCA.
  stateProvince     String?

  /// Country from HCA.
  country           String?

  /// ZIP or postal code from HCA.
  zipPostalCode     String?

  /// YSWS verification status from HCA (e.g. "verified_eligible", "verified_but_over_18").
  verificationStatus String?

  ownedFrames       Frame[]
  sessions          Session[]
  submissions       Submission[]

  @@index([slackId])
}

model Session {
  /// The unique ID of the session.
  id                String        @id @default(cuid())

  /// The user ID this session belongs to.
  userId            Int

  /// The user this session belongs to.
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// When this session was created.
  createdAt         DateTime      @default(now())

  /// When this session expires.
  expiresAt         DateTime

  @@index([userId])
}

/// Represents an iframe on the main canvas.
model Frame {
  /// The unique ID of the frame.
  id        Int           @id @default(autoincrement())

  /// The URL of the frame.
  url       String

  ownerId   Int
  owner     User          @relation(fields: [ownerId], references: [id])

  /// Whether this frame is pending approval.
  isPending         Boolean     @default(true)

  /// The approved time in seconds (sum of Hackatime project times).
  approvedTime      Float       @default(0)

  /// Number of tiles placed for this frame.
  placedTiles       Int         @default(0)

  /// Comma-delimited list of Hackatime project names.
  projectNames      String

  /// The time when this frame was created.
  createdAt         DateTime      @default(now())

  /// DEPRECATED: the Airtable ID associated with the frame, from when prize
  /// fulfillment synced to Airtable. Kept for historical records; no longer written to.
  airtableId        String?

  /// The submission this frame was created from.
  submissionId      Int?          @unique
  submission        Submission?   @relation(fields: [submissionId], references: [id])

  tiles     Tile[]
}

/// Represents a tile belonging to a `Frame`.
model Tile {
  @@id([x, y])
  x       Int
  y       Int

  /// The time that this tile has been created or modified at.
  placedAt    DateTime  @default(now())

  frameId     Int
  frame       Frame     @relation(fields: [frameId], references: [id])
}

/// Represents a project submission for review.
model Submission {
  id                    Int               @id @default(autoincrement())

  /// The iframe-able URL for the project.
  iframeUrl             String

  /// The repository URL for the project.
  repoUrl               String

  /// Project description.
  description           String

  /// Comma-delimited list of Hackatime project names.
  hackatimeProjectNames String

  /// DEPRECATED: whether the user wanted the $5/hr hosting credit prize. The prize
  /// program has been discontinued; kept for historical records, no longer settable.
  wantsPrize            Boolean           @default(false)

  /// Review status of this submission.
  status                SubmissionStatus  @default(PENDING)

  /// Feedback from the reviewer (used on rejection). Set by the AI reviewer or an admin.
  reviewerFeedback      String?

  /// When this submission was reviewed.
  reviewedAt            DateTime?

  /// Identifies who reviewed this submission: a Slack ID for a manual admin review,
  /// or "ai:<model>" for an automated review.
  reviewedBy            String?

  /// DEPRECATED: whether this submission was synced to Airtable for prize fulfillment.
  /// Kept for historical records; no longer written to.
  airtableSynced        Boolean           @default(false)

  /// DEPRECATED: the Airtable record ID if synced. Kept for historical records.
  airtableRecordId      String?

  /// The user who created this submission.
  ownerId               Int
  owner                 User              @relation(fields: [ownerId], references: [id])

  /// The frame created from this submission.
  frame                 Frame?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([ownerId])
  @@index([status])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Tracks progress of the one-off job that migrates legacy submissions still
/// stuck in manual PENDING review onto the automated AI review pipeline.
/// Singleton row (id is always 1) so a DB-level compare-and-swap on `status`
/// guarantees only one migration run is ever in flight.
model SubmissionMigrationJob {
  id                  Int       @id @default(1)

  status              MigrationJobStatus @default(IDLE)

  /// Number of legacy submissions captured when the job started.
  totalCount          Int       @default(0)

  /// Number of legacy submissions processed so far (approved + rejected + errored).
  processedCount      Int       @default(0)

  approvedCount       Int       @default(0)
  rejectedCount       Int       @default(0)
  errorCount          Int       @default(0)

  /// The submission currently being reviewed, if any.
  currentSubmissionId Int?

  /// The last error message encountered, if any.
  lastError           String?

  startedAt           DateTime?
  finishedAt          DateTime?
}

enum MigrationJobStatus {
  IDLE
  RUNNING
  DONE
  FAILED
}
