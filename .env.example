DATABASE_URL=

# Hack Club Auth OAuth credentials
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

HACKATIME_ADMIN_KEY=

# Delimited by semicolons.
ADMIN_SLACK_IDS=

# Slack bot token for sending approval/rejection DMs
SLACK_BOT_TOKEN=

# Groq API key, used to run the automated submission reviewer (openai/gpt-oss-120b).
GROQ_API_KEY=

# Optional: a GitHub personal access token (no scopes needed) used by the automated
# reviewer when browsing submitted repos, to raise the GitHub API rate limit above the
# unauthenticated 60 requests/hour.
GITHUB_TOKEN=

# DEPRECATED: only used by the unused, deprecated Airtable sync in src/lib/airtable.ts,
# which synced submissions to Airtable for the discontinued $5/hr hosting credit prize.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
